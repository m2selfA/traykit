#include <windows.h>
1 ICON "traykit.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 0,3,3,0
 PRODUCTVERSION 0,3,3,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "TrayKit"
   VALUE "FileDescription", "TrayKit - Windows Tray Toolbox"
   VALUE "FileVersion", "0.3.3"
   VALUE "InternalName", "traykit"
   VALUE "OriginalFilename", "traykit.exe"
   VALUE "ProductName", "TrayKit"
   VALUE "ProductVersion", "0.3.3"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
